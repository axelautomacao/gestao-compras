rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra padrão: usuários autenticados podem ler e escrever
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Regras específicas para coleções (opcional - mais seguro)
    
    // Usuários: apenas leitura do próprio perfil
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Obras: todos autenticados podem ler, apenas admin/diretor podem criar/editar
    match /obras/{obraId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && 
        (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role in ['admin', 'diretor']);
      allow delete: if request.auth != null && 
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Compras: todos autenticados podem ler e criar
    match /compras/{compraId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }
    
    // Notificações: apenas o próprio usuário pode ler suas notificações
    match /notificacoes/{notifId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
