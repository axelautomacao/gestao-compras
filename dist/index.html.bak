                                    <div class="max-w-xs mx-auto"><canvas id="donutChart"></canvas></div>
                                    <div id="cc-drilldown-table-wrapper" class="overflow-auto max-h-60">
                                        <table class="min-w-full text-sm">
                                            <thead>
                                                <tr>
                                                    <th class="px-3 py-2 text-left text-xs text-gray-500 uppercase">
                                                        Centro de Custo</th>
                                                    <th class="px-3 py-2 text-left text-xs text-gray-500 uppercase">
                                                        Valor</th>
                                                    <th class="px-3 py-2 text-left text-xs text-gray-500 uppercase">
                                                        % do
                                                        Total</th>
                                                </tr>
                                            </thead>
                                            <tbody id="cc-summary-table" class="divide-y divide-gray-200"></tbody>
                                        </table>
