                                    <canvas id="barChart" style="height:360px; max-height:360px;"></canvas>
                                </div>
                                <div class="card h-full">
                                    <h3 class="text-lg font-medium text-center mb-2">Gasto por Natureza</h3>
                                    <canvas id="pieChart" style="height:360px; max-height:360px;"></canvas>
                                </div>
