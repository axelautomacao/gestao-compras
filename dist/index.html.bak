                            <div class="card">
                                <div class="flex items-center justify-between mb-3">
                                    <div>
                                        <h3 class="text-lg font-medium">Calend&aacute;rio de Compras</h3>
                                        <p class="text-sm text-gray-500">Emiss&atilde;oo, previs&atilde;o e
                                            recebimento.
                                        </p>
                                    </div>
                                    <div class="flex gap-2 items-center">
                                        <button id="btn-calendar-prev" class="btn-secondary btn-small" &larr;/button>
                                            <button id="btn-calendar-next" class="btn-secondary btn-small"
                                                &larr;/button>
                                                <select id="calendar-filter-type" class="input">
                                                    <option value="all">Tudo</option>
                                                    <option value="compra">Emiss&atilde;oo</option>
                                                    <option value="previsao">Previs&atilde;o</option>
                                                    <option value="recebimento">Recebimento</option>
                                                </select>
                                    </div>
                                </div>
                                <div id="dashboard-calendar" class="w-full h-80 border rounded-lg bg-white"></div>
                            </div>
                            <div class="card">
                                <div class="flex justify-between items-center mb-4">
                                    <h3 class="text-lg font-bold">Hist&oacute;rico de Compras da Obra</h3>
                                    <button id="btn-export-csv" class="btn-secondary btn-small">Exportar
                                        CSV</button>
                                </div>
                                <div class="overflow-x-auto">
                                    <table class="min-w-full divide-y divide-gray-200">
                                        <thead class="bg-gray-50">
                                            <tr>
                                                <th
                                                    class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">
                                                    Data Solicita&ccedil;&atilde;o</th>
