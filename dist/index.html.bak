﻿<meta charset="UTF-8">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gestão de Compras de Obras (Axel v10)</title>
<!-- Firebase config fallback para execução estática (usado se env.js/env vars não forem injectados) -->
<meta name="VITE_FIREBASE_API_KEY" content="SUA_API_KEY">
<meta name="VITE_FIREBASE_AUTH_DOMAIN" content="seu-projeto.firebaseapp.com">
<meta name="VITE_FIREBASE_PROJECT_ID" content="seu-projeto-id">
<meta name="VITE_FIREBASE_STORAGE_BUCKET" content="seu-projeto.appspot.com">
<meta name="VITE_FIREBASE_MESSAGING_SENDER_ID" content="000000000000">
<meta name="VITE_FIREBASE_APP_ID" content="1:000000000000:web:xxxxxxxxxxxxxx">

<script src="https://cdn.tailwindcss.com"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script
    src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
<script
    src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/vis-timeline@7.7.2/dist/vis-timeline-graph2d.min.css">
<script src="https://cdn.jsdelivr.net/npm/vis-timeline@7.7.2/dist/vis-timeline-graph2d.min.js"></script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel='icon' type='image/png' href='./images/favicon.png'>

<!-- Fase 1: Melhorias Visuais -->
<link rel='stylesheet' href='./css/phase1-improvements.css'>
<link rel='stylesheet' href='./css/login-animation.css'>

<style>
    :root {
        --axel-green: #2E9A45;
        --axel-green-hover: #257a38;
        --axel-red: #EF4444;
        --axel-red-hover: #c82a2a;
        --axel-gray-text: #374151;
        --axel-gray-light: #F9FAFB;
        --axel-gray-border: #E5E7EB;

        /* Cores de Fundo */
        --bg-primary: #ffffff;
        --bg-secondary: #F9FAFB;
        --bg-tertiary: #F3F4F6;
        --bg-sidebar: #1F2937;
        --bg-sidebar-hover: #374151;
        --bg-modal: #ffffff;
        --bg-input: #ffffff;

        /* Cores de Texto */
        --text-primary: #374151;
        --text-secondary: #6B7280;
        --text-on-sidebar: #D1D5DB;
        --text-on-sidebar-active: #FFFFFF;

        /* Cores de Borda */
        --border-color: #E5E7EB;
    }

    /* Definições do Tema Escuro (Item 10) */
    :root.dark {
        --bg-primary: #0f172a;
        --bg-secondary: #111827;
        --bg-tertiary: #0b1220;

        --bg-modal: #111827;
        --bg-input: #1f2937;

        --text-primary: #e2e8f0;
        --text-secondary: #94a3b8;

        --border-color: #1f2937;
    }

    html, body {
        height: 100%;
    }

    body {
        font-family: 'Poppins', sans-serif;
        color: var(--text-primary);
        background-color: var(--bg-tertiary);
        margin: 0;
        padding: 0;
        /* Aplicando tema */
        transition: background-color 0.2s, color 0.2s;
    }

    /* Aplica tema aos cards, modais, inputs, etc. */
    .card {
        background-color: var(--bg-primary);
        border-color: var(--border-color);
        border-width: 1px;
        border-radius: 0.5rem;
        padding: 1.5rem;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
    }

    dialog {
        background-color: var(--bg-modal);
    }

    .input,
    .input-group select {
        background-color: var(--bg-input);
        color: var(--text-primary);
        border-color: var(--border-color);
        min-height: 44px;
    }

    select.input,
    textarea.input {
        min-height: 44px;
    }

    .input::placeholder {
        color: var(--text-secondary);
    }

    .input-group {
        border-color: var(--border-color);
    }

    #pdfContainer {
        background-color: var(--bg-secondary);
    }

    .orcamento-resumo-grid {
        background-color: var(--bg-secondary);
        border-color: var(--border-color);
    }

    .cadastro-list-item {
        border-color: var(--border-color);
    }

    table thead {
        background-color: var(--bg-secondary);
    }

    table tbody {
        border-color: var(--border-color);
    }

    :root.dark table thead {
        background-color: #374151;
    }

    /* Botões */
    .btn {
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        color: white;
        background-color: var(--axel-green);
        font-weight: 500;
        transition: background-color 0.2s;
        cursor: pointer;
    }

    .btn:hover {
        background-color: var(--axel-green-hover);
    }

    .btn-secondary {
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        font-weight: 500;
        background-color: #e5e7eb;
        color: #374151;
        transition: background-color 0.2s;
        cursor: pointer;
    }

    .btn-secondary:hover {
        background-color: #d1d5db;
    }

    :root.dark .btn-secondary {
        background-color: #4B5563;
        color: #F9FAFB;
    }

    :root.dark .btn-secondary:hover {
        background-color: #5a6678;
    }

    .btn-danger {
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        color: white;
        background-color: var(--axel-red);
        font-weight: 500;
        transition: background-color 0.2s;
        cursor: pointer;
    }

    .btn-danger:hover {
        background-color: var(--axel-red-hover);
    }

    .btn-small {
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
        font-size: 0.875rem;
    }

    .btn-link {
        color: var(--axel-green);
        font-weight: 500;
        cursor: pointer;
    }

    .btn-link:hover {
        text-decoration: underline;
        color: var(--axel-green-hover);
    }

    .wizard-pill {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        background: var(--bg-tertiary);
        color: var(--text-secondary);
        font-weight: 600;
    }

    .wizard-pill.wizard-active {
        background: var(--axel-green);
        color: #ffffff;
    }

    .btn-shortcut {
        padding: 0 0.5rem;
        height: 100%;
        background-color: #e5e7eb;
        color: #374151;
        border-left: 1px solid #d1d5db;
        font-size: 1.25rem;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-shortcut:hover {
        background-color: #d1d5db;
    }

    :root.dark .btn-shortcut {
        background-color: #4B5563;
        color: #F9FAFB;
        border-left-color: #5a6678;
    }

    :root.dark .btn-shortcut:hover {
        background-color: #5a6678;
    }

    .input-group {
        display: flex;
        align-items: center;
        width: 100%;
        border: 1px solid var(--border-color);
        border-radius: 0.5rem;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    .input-group:focus-within {
        border-color: var(--axel-green);
        box-shadow: 0 0 0 2px rgba(46, 154, 69, 0.4);
        outline: none;
    }

    /* Formulários */
    .input:focus {
        border-color: var(--axel-green);
        box-shadow: 0 0 0 2px rgba(46, 154, 69, 0.4);
        outline: none;
    }

    .input {
        width: 100%;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        padding: 0.5rem 0.75rem;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }

    .input.readonly-field,
    .input[readonly],
    select.readonly-field,
    select[aria-readonly="true"],
    textarea.readonly-field {
        background-color: #e5e7eb;
        cursor: not-allowed;
    }

    :root.dark .input.readonly-field,
    :root.dark .input[readonly],
    :root.dark select.readonly-field,
    :root.dark textarea.readonly-field {
        background-color: #1f2937;
    }

    select[multiple].input {
        height: 10rem;
        padding: 0;
    }

    select[multiple].input option {
        padding: 0.5rem 0.75rem;
    }

    /* Navegação Lateral (Item 4) */
    .page {
        display: none !important;
    }

    .page.active {
        display: block !important;
    }

    #sidebar {
        background-color: var(--bg-sidebar);
    }

    #main-layout {
        min-height: 100vh;
    }

    #sidebar nav {
        border-top: 1px solid var(--bg-sidebar-hover);
    }

    #sidebar.collapsed {
        width: 4.5rem;
    }

    #sidebar.collapsed .nav-link span {
        display: none;
    }

        #sidebar.collapsed .logo-text {
            display: none;
        }

        #sidebar.collapsed .nav-link {
            justify-content: center;
            padding-inline: 0.75rem;
        }

        /* Garante que modais (dialog) fiquem ocultos quando não abertos */
        dialog:not([open]) {
            display: none !important;
        }

    .nav-link {
        display: flex;
        align-items: center;
        padding: 0.75rem 1.25rem;
        border-radius: 0.5rem;
        font-size: 0.9rem;
        font-weight: 500;
        transition: background-color 0.2s, color 0.2s, border-color 0.2s;
        cursor: pointer;
        margin-bottom: 0.25rem;
        color: var(--text-on-sidebar);
        /* Borda transparente para alinhamento */
        border-left: 4px solid transparent;
    }

    .nav-link svg {
        width: 1.25rem;
        height: 1.25rem;
        margin-right: 0.75rem;
        flex-shrink: 0;
    }

    .nav-link.inactive:hover {
        background-color: var(--bg-sidebar-hover);
        color: var(--text-on-sidebar-active);
    }

    /* Correção do indicador de menu ativo */
    .nav-link.active {
        background-color: var(--bg-sidebar-hover);
        color: var(--text-on-sidebar-active);
        font-weight: 600;
        border-left: 4px solid var(--axel-green);
    }

    /* Outros estilos */
    dialog::backdrop {
        background-color: rgba(0, 0, 0, 0.5);
    }

    .cadastro-list-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 0.25rem;
        border-bottom-width: 1px;
        border-color: var(--border-color);
    }

    /* Resumo do Orçamento */
    .orcamento-resumo-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
        padding: 1.25rem;
        background: linear-gradient(135deg, #f8fafc, #eef2ff);
        border-radius: 0.75rem;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.04);
    }

    .orcamento-resumo-item {
        text-align: left;
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 0.75rem;
        padding: 0.9rem 1rem;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 100px;
    }

    .orcamento-resumo-item .label {
        font-size: 0.78rem;
        font-weight: 600;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .orcamento-resumo-item .value {
        font-size: 1.05rem;
        font-weight: 700;
        color: #1f2937;
        line-height: 1.6;
    }

    /* Ocultar elementos por permissão */
    .protected-role {
        display: none;
    }
</style>
</head>

<body class="bg-gray-100 font-poppins">

    <!-- ========================================== -->
    <!-- TELA DE TRANSIÇÃO (LOADER) -->
    <!-- ========================================== -->
    <div id="loader" class="fixed inset-0 z-[9999] bg-white flex flex-col items-center justify-center">
        <!-- Container do Logo -->
        <img id="logo-container" src="./images/logo_axel__principal.png" class="w-48 h-auto" />
        <!-- Fim do Logo SVG -->
        <p class="mt-4 text-lg font-medium text-gray-700" id="loading-message">Conectando ao banco de dados...</p>
    </div>

    <style>
        /* Ajustes do calendário (timeline) */
        #dashboard-calendar {
            width: 100%;
            height: 360px;
        }

        .vis-timeline {
            width: 100%;
        }
    </style>

    <dialog id="authModal" class="p-0 rounded-lg shadow-xl w-full max-w-sm z-50 overflow-hidden">

        <div id="auth-login-view">
            <form id="form-login" class="p-6 space-y-4">
                <h3 class="text-xl font-medium text-center">Login - Gestão de Compras</h3>
                <div id="login-error" class="hidden p-2 bg-red-100 text-red-700 text-sm rounded-md"></div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Email</label>
                    <input name="email" type="email" class="input" required />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Senha</label>
                    <input name="password" type="password" class="input" required />
                </div>

                <div class="flex justify-between items-center text-sm">
                    <div class="flex items-center space-x-2">
                        <input type="checkbox" id="check-remember-me" name="remember"
                            class="h-4 w-4 rounded text-[var(--axel-green)] border-gray-300 focus:ring-[var(--axel-green)]">
                        <label for="check-remember-me" class="text-gray-600">Lembrar-me</label>
                    </div>
                    <button type="button" id="btn-forgot-password" class="btn-link text-xs">Esqueci a senha</button>
                </div>

                <button type="submit" class="btn w-full">Entrar</button>
                <p class="text-sm text-center">Não tem uma conta? <button type="button" id="btn-show-signup"
                        class="btn-link">Registe-se</button></p>
            </form>
        </div>

        <div id="auth-signup-view" class="hidden">
            <form id="form-signup" class="p-6 space-y-4">
                <h3 class="text-xl font-medium text-center">Criar Conta</h3>
                <div id="signup-error" class="hidden p-2 bg-red-100 text-red-700 text-sm rounded-md"></div>
                <div><label class="block text-sm font-medium text-gray-700">Seu Nome</label><input name="nome"
                        type="text" class="input" required /></div>
                <div><label class="block text-sm font-medium text-gray-700">Email</label><input name="email"
                        type="email" class="input" required /></div>
                <div><label class="block text-sm font-medium text-gray-700">Senha (mín. 6 caracteres)</label><input
                        name="password" type="password" class="input" required minlength="6" /></div>
                <button type="submit" class="btn w-full">Criar Conta</button>
                <p class="text-sm text-center">Já tem uma conta? <button type="button" id="btn-show-login"
                        class="btn-link">Fazer Login</button></p>
            </form>
        </div>

        <div id="auth-forgot-view" class="hidden">
            <form id="form-forgot-password" class="p-6 space-y-4">
                <h3 class="text-xl font-medium text-center">Redefinir Senha</h3>
                <div id="forgot-success" class="hidden p-2 bg-green-100 text-green-700 text-sm rounded-md"></div>
                <div id="forgot-error" class="hidden p-2 bg-red-100 text-red-700 text-sm rounded-md"></div>

                <p class="text-sm text-gray-600">Insira o seu email. Enviaremos um link para você criar uma nova
                    senha.
                </p>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Email</label>
                    <input name="email" type="email" class="input" required />
                </div>

                <button type="submit" class="btn w-full">Enviar Link</button>
                <p class="text-sm text-center"><button type="button" id="btn-show-login-from-forgot"
                        class="btn-link">Voltar ao Login</button></p>
            </form>
        </div>

    </dialog>

    <dialog id="pdfModal" class="w-[90vw] h-[90vh] p-0 rounded-xl shadow-2xl overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2 border-b bg-gray-50">
            <div class="font-medium" id="pdfTitle">Visualizando PDF</div>
            <div class="space-x-2">
                <a id="btnDownloadPdf" href="#" download="download.pdf" class="btn-secondary btn-small"
                    target="_blank">Baixar PDF</a>
                <button id="btnClosePdf" class="btn-secondary btn-small">Fechar</button>
            </div>
        </div>
        <div id="pdfContainer" class="w-full h-[calc(90vh-48px)] overflow-auto bg-gray-200">
            <div id="pdfLoader" class="flex justify-center items-center h-full text-gray-500">Carregando...</div>
        </div>
    </dialog>

    <dialog id="confirmModal" class="p-6 rounded-lg shadow-xl z-50">
        <h3 class="text-lg font-medium" id="confirmTitle">Confirmar Ao</h3>
        <p class="py-4" id="confirmMessage">Você tem certeza?</p>
        <div class="flex justify-end space-x-2">
            <button id="btnConfirmCancel" class="btn-secondary">Cancelar</button>
            <button id="btnConfirmOk" class="btn-danger">Confirmar</button>
        </div>
    </dialog>

    <dialog id="alertCenter" class="p-0 rounded-xl shadow-2xl w-full max-w-3xl">
        <div class="p-6 space-y-4">
            <div class="flex flex-wrap justify-between items-center gap-3">
                <div>
                    <h3 class="text-xl font-semibold">Notificações</h3>
                    <p class="text-sm text-gray-500">Compras em atraso, sem previsão ou pendentes.</p>
                </div>
                <div class="flex flex-wrap gap-2 items-center">
                    <label class="text-xs text-gray-600">Urgência
                        <select id="alert-filter-urgencia" class="input mt-1 w-full">
                            <option value="all">Todas</option>
                            <option value="atrasados">Atrasadas</option>
                            <option value="sem_previsao">Sem previsão</option>
                            <option value="pendente_aprovacao">Pendentes aprovação</option>
                            <option value="cotacao">Cotação 7+ dias</option>
                        </select>
                    </label>
                    <label class="text-xs text-gray-600">Status
                        <select id="alert-filter-status" class="input mt-1 w-full">
                            <option value="all">Todos</option>
                            <option value="pendente">Pendente</option>
                            <option value="andamento">Em andamento</option>
                            <option value="recebido">Recebido</option>
                        </select>
                    </label>
                    <button data-close-alert type="button" class="btn-secondary btn-small">Fechar</button>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div class="border rounded-lg p-4 bg-amber-50 flex items-center justify-between">
                    <div>
                        <div class="text-sm text-gray-600">Compras em atraso</div>
                        <div class="text-2xl font-bold text-amber-700" data-alert-count="atrasados">0</div>
                    </div>
                    <button class="btn-secondary btn-small" data-action="view-alert-items"
                        data-alert="atrasados">Ver</button>
                </div>
                <div class="border rounded-lg p-4 bg-gray-50 flex items-center justify-between">
                    <div>
                        <div class="text-sm text-gray-600">Sem previsão</div>
                        <div class="text-2xl font-bold text-gray-700" data-alert-count="sem_previsao">0</div>
                    </div>
                    <button class="btn-secondary btn-small" data-action="view-alert-items"
                        data-alert="sem_previsao">Ver</button>
                </div>
                <div class="border rounded-lg p-4 bg-blue-50 flex items-center justify-between">
                    <div>
                        <div class="text-sm text-gray-600">Pendentes de aprovação</div>
                        <div class="text-2xl font-bold text-blue-700" data-alert-count="pendente_aprovacao">0</div>
                    </div>
                    <button class="btn-secondary btn-small" data-action="view-alert-items"
                        data-alert="pendente_aprovacao">Ver</button>
                </div>
                <div class="border rounded-lg p-4 bg-purple-50 flex items-center justify-between">
                    <div>
                        <div class="text-sm text-gray-600">Cotação (7+ dias)</div>
                        <div class="text-2xl font-bold text-purple-700" data-alert-count="cotacao">0</div>
                    </div>
                    <button class="btn-secondary btn-small" data-action="view-alert-items"
                        data-alert="cotacao">Ver</button>
                </div>
            </div>
        </div>
    </dialog>

    <dialog id="userModal" class="p-0 rounded-xl shadow-2xl w-full max-w-2xl">
        <div class="flex justify-between items-center px-4 py-3 border-b">
            <div>
                <h3 id="userModalTitle" class="text-lg font-semibold">Usuário</h3>
                <p class="text-sm text-gray-500">Defina papéis e obra padrão.</p>
            </div>
            <button id="btnUserModalClose" class="btn-secondary btn-small">Fechar</button>
        </div>
        <form id="form-user-modal" class="p-6 space-y-4">
            <div id="user-modal-error" class="text-red-600 text-sm"></div>
            <input type="hidden" id="user-id" name="id">
            <input type="hidden" id="user-uid" name="uid">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Nome *</label>
                    <input id="user-nome" class="input mt-1" required />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">E-mail</label>
                    <input id="user-email" type="email" class="input mt-1" />
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Papel</label>
                    <select id="user-role" class="input mt-1">
                        <option value="obra">Obra</option>
                        <option value="comprador">Comprador</option>
                        <option value="financeiro">Financeiro</option>
                        <option value="diretor">Diretor</option>
                        <option value="administrador">Administrador</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Obra padrão</label>
                    <select id="user-obra" class="input mt-1"></select>
                </div>
                <label class="flex items-center gap-2 text-sm mt-7">
                    <input id="user-ativo" type="checkbox" class="h-4 w-4" checked> Ativo
                </label>
            </div>
            <div class="flex justify-between items-center pt-3 border-t">
                <button type="button" id="btnUserDelete" class="btn-secondary btn-small"
                    style="display:none;">Excluir</button>
                <div class="space-x-2">
                    <button type="button" id="btnUserCancel" class="btn-secondary">Cancelar</button>
                    <button type="submit" class="btn">Salvar</button>
                </div>
            </div>
        </form>
    </dialog>

    <dialog id="obraEditModal-legacy" class="p-0 rounded-lg shadow-xl w-full max-w-3xl z-50">
        <div class="p-6">
            <h3 class="text-xl font-medium mb-4">Editar Obra</h3>
            <form id="form-edit-obra-legacy" class="space-y-3">
                <input type="hidden" name="id">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Nome da Obra *</label>
                        <input name="nome_obra" class="input" required />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Número da O.S. *</label>
                        <input name="numero_os" class="input" required />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Cliente</label>
                        <input name="cliente" class="input" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Orçamento de Materiais (R$)</label>
                        <input name="valor_orcado" data-mask="currency" class="input" required
                            data-role-field="diretor" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Tolerância (%)</label>
                        <input name="tolerancia_percentual" type="number" step="0.1" min="0" class="input"
                            placeholder="Ex: 5" data-role-field="diretor" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Empresa</label>
                        <input name="empresa" class="input" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Local de Realização</label>
                        <input name="local_realizacao" class="input" />
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700">Descrição da Obra</label>
                    <textarea name="descricao_obra" rows="2" class="input"
                        placeholder="Resumo da obra, escopo, etc."></textarea>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Data Prevista Início</label>
                        <input name="data_prevista_inicio" type="date" class="input" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Data Prevista Fim</label>
                        <input name="data_prevista_fim" type="date" class="input" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Horas Previstas</label>
                        <input name="horas_previstas" type="number" step="0.1" class="input" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Horas Extras Previstas</label>
                        <input name="horas_extras_previstas" type="number" step="0.1" class="input" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Valor Deslocamento (Km)</label>
                        <input name="valor_deslocamento_km" data-mask="currency" class="input" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Qtde Refeições</label>
                        <input name="qtd_refeicoes" type="number" class="input" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Qtde Hospedagens</label>
                        <input name="qtd_hospedagens" type="number" class="input" />
                    </div>
                    <div class="flex items-center gap-2">
                        <input id="obra-edit-filha-toggle" type="checkbox" name="is_obra_filha" class="h-4 w-4">
                        <label for="obra-edit-filha-toggle" class="text-sm text-gray-700">Obra Filha?</label>
                    </div>
                    <div id="obra-edit-filha-wrapper" class="hidden">
                        <label class="block text-sm font-medium text-gray-700">Obra Pai (OS)</label>
                        <input name="obra_pai_os" class="input" placeholder="Informe a OS da obra pai">
                    </div>
                </div>

                <div class="flex justify-end space-x-2 pt-4">
                    <button type="button" id="btnEditObraCancel" class="btn-secondary">Cancelar</button>
                    <button type="submit" class="btn">Salvar Alterações</button>
                </div>
            </form>
        </div>
    </dialog>

    <dialog id="compraEditModal" class="p-0 rounded-lg shadow-xl w-full max-w-3xl z-50">
        <div class="p-6">
            <h3 class="text-xl font-medium mb-4">Editar Compra</h3>
            <div id="edit-orcamento-resumo" class="orcamento-resumo-grid mb-4 hidden"></div>
            <form id="form-edit-compra" class="space-y-4">
                <input type="hidden" name="id">
                <input type="hidden" name="retirada_estoque" id="edit-retirada-estoque">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div><label class="block text-sm font-medium text-gray-700">Obra / O.S. *</label><select
                            name="obraId" class="input mt-1" required></select></div>

                    <div><label class="block text-sm font-medium text-gray-700">Fornecedor</label>
                        <div class="input-group mt-1">
                            <select name="fornecedorId"></select>
                        </div>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div><label class="block text-sm font-medium text-gray-700">Comprador *</label>
                        <div class="input-group mt-1">
                            <select name="compradorId" required></select>
                        </div>
                    </div>
                    <div><label class="block text-sm font-medium text-gray-700">Solicitante *</label><input
                            name="solicitante" class="input mt-1" required /></div>
                    <div><label class="block text-sm font-medium text-gray-700">Número NF-e *</label><input
                            name="numero_nf" class="input mt-1" required pattern="[0-9]*"
                            title="Apenas números são permitidos." /></div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700">Centro de Custo *</label>
                    <div class="input-group mt-1">
                        <select name="centroCustoId" required></select>
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Apelido da Compra</label>
                    <input name="apelido_compra" class="input mt-1 w-full" placeholder="Ex.: Compra Painel Lote 1" />
                </div>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Data da solicitação</label>
                        <input name="data_solicitacao" type="date" class="input mt-1" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Data de Compra *</label>
                        <input name="data_emissao" type="date" class="input mt-1" required />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Valor Total (R$) *</label>
                        <input name="valor_total" data-mask="currency" class="input mt-1" required />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Natureza da Compra *</label>
                        <select name="natureza_compra" class="input mt-1" required>
                            <option value="Lista de Material inicial">Lista de Material inicial</option>
                            <option value="Material Adicional">Material Adicional</option>
                            <option value="Desperdício">Desperdício</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div><label class="block text-sm font-medium text-gray-700">Previsão de Entrega</label><input
                            name="previsao_entrega" type="date" class="input mt-1" /></div>
                    <div><label class="block text-sm font-medium text-gray-700">Status da Compra *</label>
                        <select name="status_compra" class="input mt-1" required>
                            <option value="Nao iniciado">Nao iniciado</option>
                            <option value="Em cotacao">Em cotacao</option>
                            <option value="Aprovado">Aprovado</option>
                            <option value="Comprado">Comprado</option>
                            <option value="Recebido">Recebido</option>
                            <option value="Cancelado">Cancelado</option>
                        </select>
                    </div>
                    <div><label class="block text-sm font-medium text-gray-700">Data de Recebimento</label><input
                            name="data_recebimento" type="date" class="input mt-1" /></div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div><label class="block text-sm font-medium text-gray-700">Status Aprovação</label>
                        <select name="status_aprovacao" class="input mt-1" data-role-field="diretor">
                            <option value="Aprovado">Aprovado</option>
                            <option value="Pendente">Pendente</option>
                        </select>
                    </div>
                </div>

                <div id="edit-justificativa-wrapper" class="hidden">
                    <label class="block text-sm font-medium text-red-700">Justificativa de Estouro de Orçamento
                        *</label>
                    <textarea name="justificativa_estouro_orcamento" class="input mt-1 w-full" rows="3"
                        placeholder="Descreva o motivo para ultrapassar o limite de orçamento..."></textarea>
                </div>

                <div class="border rounded-lg p-3 space-y-2 bg-gray-50">
                    <h4 class="font-medium text-sm text-gray-800">Auditoria de Anexos</h4>
                    <div class="flex items-center">
                        <input id="edit-nf_conferida" name="nf_conferida" type="checkbox"
                            class="h-4 w-4 text-green-600 border-gray-300 rounded focus:ring-green-500">
                        <label for="edit-nf_conferida" class="ml-2 block text-sm text-gray-900">NF-e / CT-e
                            Conferido</label>
                    </div>
                    <div class="grid grid-cols-2 gap-4 text-xs">
                        <div><label class="block font-medium text-gray-500">Conferido por:</label><input
                                id="edit-nf_conferida_por" name="nf_conferida_por" type="text"
                                class="input !text-xs !py-1 bg-gray-100" readonly disabled /></div>
                        <div><label class="block font-medium text-gray-500">Conferido em:</label><input
                                id="edit-nf_conferida_em" name="nf_conferida_em" type="text"
                                class="input !text-xs !py-1 bg-gray-100" readonly disabled /></div>
                    </div>
                </div>

                <p class="text-xs text-gray-500">Nota: Para alterar os PDFs (NF-e/CT-e), é necessário excluir e
                    registrar a compra novamente.</p>
                <div class="flex justify-end space-x-2 pt-4"><button type="button" id="btnEditCompraCancel"
                        class="btn-secondary">Cancelar</button><button type="submit" class="btn">Salvar
                        Alterações</button></div>
            </form>
        </div>
    </dialog>
    <dialog id="compradorEditModal-legacy" class="p-0 rounded-lg shadow-xl w-full max-w-lg z-50">
        <div class="p-6">
            <h3 class="text-xl font-medium mb-4">Editar Comprador</h3>
            <form id="form-edit-comprador-legacy" class="space-y-3">
                <input type="hidden" name="id">
                <div><label class="block text-sm font-medium text-gray-700">Nome *</label><input name="nome"
                        class="input" required /></div>
                <div><label class="block text-sm font-medium text-gray-700">Email</label><input name="email"
                        type="email" class="input" /></div>
                <div class="flex justify-end space-x-2 pt-4"><button type="button" id="btnEditCompradorCancel-legacy"
                        class="btn-secondary">Cancelar</button><button type="submit" class="btn">Salvar
                        Alterações</button></div>
            </form>
        </div>
    </dialog>
    <dialog id="fornecedorEditModal-legacy" class="p-0 rounded-lg shadow-xl w-full max-w-lg z-50">
        <div class="p-6">
            <h3 class="text-xl font-medium mb-4">Editar Fornecedor</h3>
            <form id="form-edit-fornecedor-legacy" class="space-y-3">
                <input type="hidden" name="id">
                <div><label class="block text-sm font-medium text-gray-700">Nome *</label><input name="nome"
                        class="input" required /></div>
                <div><label class="block text-sm font-medium text-gray-700">CNPJ</label><input name="cnpj" class="input"
                        data-mask="cnpj" placeholder="00.000.000/0000-00" /></div>
                <div class="flex justify-end space-x-2 pt-4"><button type="button" id="btnEditFornecedorCancel-legacy"
                        class="btn-secondary">Cancelar</button><button type="submit" class="btn">Salvar
                        Alterações</button></div>
            </form>
        </div>
    </dialog>
    <dialog id="centroCustoEditModal" class="p-0 rounded-lg shadow-xl w-full max-w-lg z-50">
        <div class="p-6">
            <h3 class="text-xl font-medium mb-4">Editar Centro de Custo</h3>
            <form id="form-edit-centro-custo" class="space-y-3">
                <input type="hidden" name="id">
                <div><label class="block text-sm font-medium text-gray-700">Nome *</label><input name="nome"
                        class="input" required /></div>
                <div><label class="block text-sm font-medium text-gray-700">Código</label><input name="codigo"
                        class="input" /></div>
                <div class="flex justify-end space-x-2 pt-4"><button type="button" id="btnEditCentroCustoCancel"
                        class="btn-secondary">Cancelar</button><button type="submit" class="btn">Salvar
                        Alterações</button></div>
            </form>
        </div>
    </dialog>

    <div class="flex hidden dashboard-content" id="main-layout">
        <aside id="sidebar"
            class="w-64 bg-gray-800 text-white h-screen sticky top-0 flex flex-col flex-shrink-0 transition-transform duration-200 transform -translate-x-full md:translate-x-0 md:static md:block"
            data-collapsible="true">

            <div class="p-6 flex items-center justify-center border-b border-gray-700">
                <img src="./images/logo_axel__principal.png" alt="Logo da Axel" class="h-10 w-auto">
            </div>

            <nav id="navigation" class="flex-grow p-4 space-y-1">
            </nav>

            <div class="p-4 border-t border-gray-700">
                <div id="user-info" class="text-xs text-gray-400 mb-2 truncate" title="Utilizador Logado">...</div>
                <button id="btn-logout" class="btn-danger w-full btn-small !py-2">Sair</button>
            </div>
        </aside>

        <main id="content-area" class="flex-grow h-screen overflow-y-auto">
            <header
                class="sticky top-0 z-40 bg-[var(--bg-primary)]/95 backdrop-blur border-b border-[var(--border-color)]">
                <div
                    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                    <div class="flex items-center gap-2">
                        <button id="btn-toggle-sidebar" class="btn-secondary btn-small !py-2 !px-3"
                            title="Abrir/fechar menu">
                            ☰
                        </button>
                        <div class="relative w-full md:w-72">
                            <input id="global-search" type="search" class="input pl-3 pr-10"
                                placeholder="Buscar compras, obras ou fornecedores..." />
                            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">🔍</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 flex-wrap md:flex-nowrap">
                        <div class="flex items-center gap-2">
                            <label class="text-sm text-[var(--text-secondary)] whitespace-nowrap">Contexto</label>
                            <select id="context-obra-select" class="input w-48">
                                <option value="*">Todas as Obras</option>
                            </select>
                        </div>
                        <button id="btn-open-alert-center" class="btn-secondary btn-small !py-2 !px-3 relative"
                            title="Notificações" aria-label="Notificações">
                            🔔
                            <span id="notifications-badge"
                                class="hidden absolute -top-1 -right-1 bg-red-600 text-white text-xs font-bold rounded-full px-2 py-0.5 leading-none">0</span>
                        </button>
                        <div class="flex items-center gap-2">
                            <div
                                class="h-8 w-8 rounded-full bg-[var(--axel-green)] text-white flex items-center justify-center text-sm font-semibold">
                                AX</div>
                            <div class="text-left leading-tight">
                                <div class="text-sm font-semibold" id="user-name-top">Usuário</div>
                                <div class="text-xs text-[var(--text-secondary)]" id="user-role-top">--</div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
            <div class="max-w-7xl mx-auto p-4 sm:px-6 lg:px-8 space-y-6">

                <section id="page-dashboard-geral" class="page active space-y-6">
                    <div class="card">
                        <h2 class="text-xl font-bold mb-4">Dashboard Geral</h2>
                        <div id="dashboard-geral-kpis" class="grid grid-cols-1 md:grid-cols-4 gap-4">
                            <div class="card text-center bg-gray-50 border border-gray-200">
                                <div class="text-sm font-medium text-gray-500">Obras Ativas</div>
                                <div id="kpi-geral-obras" class="text-2xl font-bold text-gray-700">-</div>
                            </div>
                            <div class="card text-center bg-gray-50 border border-gray-200">
                                <div class="text-sm font-medium text-gray-500">Orçamento Total</div>
                                <div id="kpi-geral-orcamento" class="text-2xl font-bold text-blue-600">-</div>
                            </div>
                            <div class="card text-center bg-gray-50 border border-gray-200">
                                <div class="text-sm font-medium text-gray-500">Comprometido Total</div>
                                <div id="kpi-geral-Gasto" class="text-2xl font-bold text-red-600">-</div>
                            </div>
                            <div class="card text-center bg-gray-50 border border-gray-200">
                                <div class="text-sm font-medium text-gray-500">% Orçamento Usado</div>
                                <div id="kpi-geral-percent" class="text-2xl font-bold text-gray-700">-</div>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-4">
                            <div class="card text-center bg-emerald-50 border border-emerald-200">
                                <div class="text-sm font-medium text-gray-500">Economia Gerada</div>
                                <div id="kpi-geral-economia" class="text-2xl font-bold text-emerald-700">-</div>
                            </div>
                            <div class="card text-center bg-indigo-50 border border-indigo-200">
                                <div class="text-sm font-medium text-gray-500">SLA Entregas</div>
                                <div id="kpi-geral-sla" class="text-2xl font-bold text-indigo-700">-</div>
                            </div>
                            <div class="card text-center bg-amber-50 border border-amber-200">
                                <div class="text-sm font-medium text-gray-500">Lead Time Médio</div>
                                <div id="kpi-geral-lead" class="text-2xl font-bold text-amber-700">-</div>
                            </div>
                            <div class="card text-center bg-rose-50 border border-rose-200">
                                <div class="text-sm font-medium text-gray-500">Compras em Atraso</div>
                                <div id="kpi-geral-atrasos" class="text-2xl font-bold text-rose-700">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div class="card">
                            <h3 class="text-lg font-medium text-center mb-2">% Orçamento Consumido por Obra</h3>
                            <canvas id="barChartGeral"></canvas>
                        </div>
                        <div class="card">
                            <h3 class="text-lg font-medium text-center mb-2">Gastos Totais por Natureza</h3><canvas
                                id="pieChartGeral"></canvas>
                        </div>
                    </div>
                    <div class="card">
                        <h3 class="text-lg font-medium text-center mb-2">Evolução de Compras (Por Mês)</h3>
                        <canvas id="lineChartGeral"></canvas>
                    </div>
                </section>

                <section id="page-dashboard" class="page space-y-6">
                    <div class="card">
                        <h2 id="dashboard-title" class="text-xl font-bold text-center mb-4">Selecione a Obra para
                            Análise</h2>
                        <div class="w-full max-w-xl mx-auto space-y-2">
                            <div class="grid grid-cols-2 gap-2">
                                <input id="dashboard-search-query" type="text" class="input"
                                    placeholder="Buscar por Nome/OS...">
                                <select id="dashboard-status-filter" class="input">
                                    <option value="Ativas">Ativas (Não Iniciada / Em Andamento)</option>
                                    <option value="Todas">Todas</option>
                                    <option value="Não Iniciada">Não Iniciada</option>
                                    <option value="Em Andamento">Em Andamento</option>
                                    <option value="Finalizada">Finalizada</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700">Selecione a Obra:</label>
                                <div class="flex items-center gap-2 mt-1">
                                    <select id="dashboard-obra-select" class="input w-full">
                                        <option value="">-- Use os filtros acima --</option>
                                    </select>
                                    <button id="btn-dashboard-refresh" class="btn-secondary btn-small !p-2 hidden"
                                        title="Atualizar dados da obra">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                            stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h2 id="dashboard-analysis-title" class="text-2xl font-bold text-center -my-2 hidden"></h2>
                    <div id="dashboard-alert"
                        class="hidden mt-2 px-4 py-3 rounded border border-amber-200 bg-amber-50 text-amber-800 text-sm">
                    </div>

                    <div id="dashboard-content" class="hidden space-y-6">
                        <!-- KPIs Principais -->
                        <div class="card space-y-4">
                            <h3 class="text-lg font-semibold text-gray-800">KPIs Principais</h3>
                            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                                <div class="card text-center bg-emerald-50 border border-emerald-200">
                                    <div class="flex items-center justify-between text-sm font-medium text-gray-500">
                                        <span>Total Orçado</span>
                                        <svg class="w-4 h-4 text-gray-400" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="1.5">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                d="M4 19h16M7 16v-5m5 5V9m5 7V5" />
                                        </svg>
                                    </div>
                                    <div id="kpi-combined-total" class="text-2xl font-bold text-gray-800"></div>
                                </div>
                                <div class="card text-center bg-rose-50 border border-rose-200">
