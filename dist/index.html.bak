                        </div>
                    </div>
                </section>

                <section id="page-obras" class="page">
                    <div class="card">
                        <h2 class="text-xl font-bold mb-4">Gestão de Obras</h2>
                        <div class="overflow-x-auto">
                            <table class="min-w-full divide-y divide-gray-200">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">
                                            Nome
                                            da Obra</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">
                                            Número O.S.</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">
                                            Cliente</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">
                                            Status</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">
                                            Ações</th>
                                    </tr>
                                </thead>
                                <tbody id="obras-table-body" class="divide-y divide-gray-200"></tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <section id="page-relatorio-compras" class="page">
                    <div class="card">
                        <h2 class="text-xl font-bold mb-4">Relatório e Gestão de Compras</h2>

                        <div class="space-y-4 mb-4 p-4 border rounded-lg bg-gray-50">
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">Fornecedor</label>
                                    <div class="input-group mt-1">
                                        <select id="report-filter-fornecedor-top" name="fornecedorId"></select>
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">Comprador *</label>
                                    <div class="input-group mt-1">
                                        <select id="report-filter-comprador-top" name="compradorId" required></select>
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">Numero NF-e *</label>
                                    <input id="report-filter-numero" name="numero_nf" class="input mt-1" required
                                        pattern="[0-9]*" title="Apenas numeros sao permitidos." />
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700">Centro de Custo *</label>
                                <div class="input-group mt-1">
                                    <select id="report-filter-centrocusto-top" name="centroCustoId" required></select>
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700">Descricao da Compra</label>
                                <textarea id="report-filter-descricao" name="descricao_compra" rows="2"
                                    class="input mt-1 w-full"
                                    placeholder="Ex.: Materiais eletricos para painel, lote 1..."></textarea>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div><label class="block text-sm font-medium text-gray-700 mb-1">Data Emissão
                                        (Início)</label><input id="report-filter-date-start" type="date" class="input">
                                </div>
                                <div><label class="block text-sm font-medium text-gray-700 mb-1">Data Emissão
                                        (Fim)</label><input id="report-filter-date-end" type="date" class="input">
                                </div>
                                <div class="hidden md:flex items-end"></div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div class="space-y-2">
                                    <div class="flex justify-between items-center gap-2">
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Filtrar por
                                            Obra</label>
                                        <button id="report-filter-obra-clear" type="button"
                                            class="btn-secondary btn-small">Limpar</button>
                                    </div>
                                    <input id="report-filter-obra-search" class="input" placeholder="Buscar por nome, OS ou apelido...">
                                    <select id="report-filter-obra" class="input" multiple size="8"></select>
                                </div>
                                <div><label class="block text-sm font-medium text-gray-700 mb-1">Filtrar por
                                        Fornecedor</label><select id="report-filter-fornecedor" class="input" multiple
                                        size="4"></select></div>
                                <div><label class="block text-sm font-medium text-gray-700 mb-1">Filtrar por
                                        Comprador</label><select id="report-filter-comprador" class="input" multiple
                                        size="4"></select></div>
                            </div>
                            <p class="text-xs text-gray-500">Dica: Segure CTRL (ou CMD) para selecionar múltiplos
                                itens
                                nas listas.</p>
                            <div class="flex justify-end items-center">
                                <button id="btn-report-buscar" type="button" class="btn px-6 py-2">Buscar
                                    Compras</button>
                            </div>
                        </div>

                        <div class="flex justify-between items-center mb-4">
                            <p class="text-sm text-gray-500">Escolha como quer visualizar os resultados:</p>
                            <div class="flex gap-2">
                                <button id="view-table-toggle" class="btn btn-small">Tabela</button>
                                <button id="view-kanban-toggle" class="btn-secondary btn-small">Quadro
                                    (Kanban)</button>
                            </div>
                        </div>

                        <div id="kanban-board" class="hidden">
                            <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4">
                                <div class="card" data-kanban-column="Nao iniciado">
                                    <div class="flex justify-between items-center mb-2">
                                        <h4 class="font-semibold">Solicitado</h4>
                                        <span class="text-xs text-gray-500" data-kanban-count="Nao iniciado">0</span>
                                    </div>
                                    <div class="space-y-3" id="kanban-col-nao-iniciado"></div>
                                </div>
                                <div class="card" data-kanban-column="Em cotacao">
                                    <div class="flex justify-between items-center mb-2">
                                        <h4 class="font-semibold">Em Cotação</h4>
                                        <span class="text-xs text-gray-500" data-kanban-count="Em cotacao">0</span>
                                    </div>
                                    <div class="space-y-3" id="kanban-col-em-cotacao"></div>
                                </div>
                                <div class="card" data-kanban-column="Aprovado">
                                    <div class="flex justify-between items-center mb-2">
                                        <h4 class="font-semibold">Aprovado</h4>
                                        <span class="text-xs text-gray-500" data-kanban-count="Aprovado">0</span>
                                    </div>
                                    <div class="space-y-3" id="kanban-col-aprovado"></div>
                                </div>
                                <div class="card" data-kanban-column="Comprado">
                                    <div class="flex justify-between items-center mb-2">
                                        <h4 class="font-semibold">Comprado</h4>
                                        <span class="text-xs text-gray-500" data-kanban-count="Comprado">0</span>
                                    </div>
                                    <div class="space-y-3" id="kanban-col-comprado"></div>
                                </div>
                                <div class="card" data-kanban-column="Recebido">
                                    <div class="flex justify-between items-center mb-2">
                                        <h4 class="font-semibold">Recebido</h4>
                                        <span class="text-xs text-gray-500" data-kanban-count="Recebido">0</span>
                                    </div>
                                    <div class="space-y-3" id="kanban-col-recebido"></div>
                                </div>
                            </div>
                        </div>

                        <div class="overflow-x-auto" id="report-table-wrapper">
                            <table class="min-w-full divide-y divide-gray-200">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase cursor-pointer"
                                            data-sort="obra">Obra (OS)</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase"
                                            data-sort="nf">NF-e</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase"
                                            data-sort="status">Status</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase"
                                            data-sort="recebimento">Data Receb.</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase"
                                            data-sort="emissao">Data Emissão</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase"
                                            data-sort="comprador">Comprador</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase"
                                            data-sort="valor">Valor</th>
                                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">
                                            PDFs
                                        </th>
                                        <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">
                                            Ações</th>
                                    </tr>
                                </thead>
                                <tbody id="report-table-body" class="divide-y divide-gray-200"></tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <section id="page-registro" class="page">
                    <div class="max-w-4xl mx-auto space-y-4">
                        <form id="form-compra" class="space-y-4">
                            <div class="flex items-center gap-2 text-sm text-[var(--text-secondary)]">
                                <span class="font-semibold text-[var(--text-primary)]">Etapas:</span>
                                <div class="flex gap-2 flex-wrap">
                                    <span class="wizard-pill wizard-active" data-step-pill="1">1) Obra</span>
                                    <span class="wizard-pill" data-step-pill="2">2) Financeiro</span>
                                    <span class="wizard-pill" data-step-pill="3">3) Logística & Anexos</span>
                                </div>
                            </div>

                            <div class="wizard-step" data-step="1">
                                <div class="card space-y-4">
                                    <div class="flex items-start justify-between">
                                        <div>
                                            <h2 class="text-xl font-bold">Registrar Nova Compra</h2>
                                            <p class="text-sm text-gray-500">Primeiro selecione a obra para carregar
                                                o
                                                orcamento.</p>
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                        <div class="md:col-span-2 space-y-2">
                                            <label class="block text-sm font-medium text-gray-700">Buscar Obra
                                                *</label>
                                            <div class="grid grid-cols-2 gap-2">
                                                <input id="registro-search-query" type="text" class="input"
                                                    placeholder="Buscar por Nome/OS...">
                                                <select id="registro-status-filter" class="input">
                                                    <option value="Ativas">Ativas (Nao Iniciada / Em Andamento)
                                                    </option>
                                                    <option value="Todas">Todas</option>
                                                </select>
                                            </div>
                                            <select name="obraId" id="registro-obra-select" class="input" required>
                                                <option value="">-- Use os filtros acima --</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div id="registro-orcamento-resumo" class="orcamento-resumo-grid hidden"></div>
                                    <div class="flex justify-end gap-2">
                                        <button type="button" class="btn-secondary" data-action="wizard-prev"
                                            disabled>Voltar</button>
                                        <button type="button" class="btn" data-action="wizard-next"
                                            data-next-step="2">Próximo</button>
                                    </div>
                                </div>
                            </div>

                            <div class="wizard-step hidden" data-step="2">
                                <div class="card space-y-4">
                                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Fornecedor</label>
                                            <div class="input-group mt-1">
                                                <select name="fornecedorId"></select>
                                            </div>
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Comprador
                                                *</label>
                                            <div class="input-group mt-1">
                                                <select name="compradorId" required></select>
                                            </div>
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Solicitante
                                                *</label>
                                            <input name="solicitante" class="input mt-1" required
                                                placeholder="Quem solicitou a compra" />
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Numero NF-e
                                                *</label>
                                            <input name="numero_nf" class="input mt-1" required pattern="[0-9]*"
                                                title="Apenas numeros sao permitidos." />
                                        </div>
                                    </div>

                                    <div>
                                        <label class="block text-sm font-medium text-gray-700">Centro de Custo
                                            *</label>
                                        <div class="input-group mt-1">
                                            <select name="centroCustoId" required></select>
                                        </div>
                                    </div>

                                    <div>
                                        <label class="block text-sm font-medium text-gray-700">Descricao da
                                            Compra</label>
                                        <textarea name="descricao_compra" rows="2" class="input mt-1 w-full"
                                            placeholder="Ex.: Materiais eletricos para painel, lote 1..."></textarea>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700">Apelido da Compra</label>
                                        <input name="apelido_compra" class="input mt-1 w-full"
                                            placeholder="Ex.: Compra Painel Lote 1" />
                                    </div>

                                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Data da
                                                solicitação</label>
                                            <input name="data_solicitacao" type="date" class="input mt-1" />
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Data de Compra
                                                *</label>
                                            <input name="data_emissao" type="date" class="input mt-1" required />
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Valor Total
                                                (R$) *</label>
                                            <input name="valor_total" data-mask="currency" class="input mt-1"
                                                required />
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Natureza da
                                                Compra
                                                *</label>
                                            <select name="natureza_compra" class="input mt-1" required>
                                                <option value="Lista de Material inicial">Lista de Material inicial
                                                </option>
                                                <option value="Material Adicional">Material Adicional</option>
                                                <option value="Desperdicio">Desperdicio</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="flex justify-start">
                                        <div
                                            class="flex items-center p-3 border rounded-lg bg-[var(--axel-green)] text-white gap-3">
                                            <input id="registro-retirada-estoque" type="checkbox"
                                                name="retirada_estoque"
                                                class="h-4 w-4 rounded border-green-600 text-white focus:ring-green-700 bg-green-600 checked:bg-green-600 checked:border-green-700">
                                            <label for="registro-retirada-estoque"
                                                class="ml-2 block text-sm font-medium text-white">Retirada do
                                                Estoque?</label>
                                        </div>
                                    </div>
                                    <div class="flex justify-between gap-2">
                                        <button type="button" class="btn-secondary"
                                            data-action="wizard-prev">Voltar</button>
                                        <button type="button" class="btn" data-action="wizard-next"
                                            data-next-step="3">Próximo</button>
                                    </div>
                                </div>
                            </div>

                            <div class="wizard-step hidden" data-step="3">
                                <div class="card space-y-4">
                                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Previsao de
                                                Entrega</label>
                                            <input name="previsao_entrega" type="date" class="input mt-1" />
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Status da Compra
                                                *</label>
                                            <select name="status_compra" class="input mt-1" required>
                                                <option value="Nao iniciado">Nao iniciado</option>
                                                <option value="Em cotacao">Em cotacao</option>
                                                <option value="Aprovado">Aprovado</option>
                                                <option value="Comprado">Comprado</option>
                                                <option value="Recebido">Recebido</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Data de
                                                Recebimento</label>
                                            <input name="data_recebimento" type="date" class="input mt-1" />
                                        </div>
                                    </div>

                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <div class="border rounded-lg p-3">
                                            <label class="block text-sm font-medium text-gray-700">PDF da NF-e
                                                (Opcional,
                                                max 20MB)</label>
                                            <input name="pdf_nf" type="file" accept="application/pdf"
                                                class="input mt-1 file:btn-secondary file:btn-small file:border-0 file:mr-2" />
                                        </div>
                                        <div class="border rounded-lg p-3">
                                            <label class="block text-sm font-medium text-gray-700">PDF do CT-e
                                                (Opcional,
                                                max 20MB)</label>
                                            <input name="pdf_cte" type="file" accept="application/pdf"
                                                class="input mt-1 file:btn-secondary file:btn-small file:border-0 file:mr-2" />
                                        </div>
                                    </div>

                                    <div id="registro-justificativa-wrapper" class="hidden">
                                        <label class="block text-sm font-medium text-red-700">Justificativa de
                                            Estouro
                                            de
                                            Orcamento *</label>
                                        <textarea name="justificativa_estouro_orcamento" class="input mt-1 w-full"
                                            rows="3"
                                            placeholder="Descreva o motivo para ultrapassar o limite de orcamento..."></textarea>
                                    </div>

                                    <div class="flex justify-between">
                                        <button type="button" class="btn-secondary"
                                            data-action="wizard-prev">Voltar</button>
                                        <button type="submit" class="btn px-6 py-3 text-base font-semibold">Salvar
                                            Compra</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </section>

                <section id="page-cadastro-obras" class="page space-y-6">
                    <div id="cadastros-voltar-btn-wrapper" class="hidden">
                        <button type="button" data-action="go-back" class="btn-secondary btn-small">←
                            Voltar</button>
                    </div>

                    <div class="card">
                        <h2 class="text-xl font-bold mb-4">Cadastrar Nova Obra</h2>
                        <form id="form-obra" class="space-y-4">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label for="obra-nome" class="block text-sm font-medium text-gray-700 mb-1">Nome
                                        da
                                        Obra *</label>
                                    <input id="obra-nome" name="nome_obra" class="input" required />
                                </div>
                                <div>
                                    <label for="obra-os" class="block text-sm font-medium text-gray-700 mb-1">Número
                                        da
                                        O.S. (único) *</label>
                                    <input id="obra-os" name="numero_os" class="input" required />
                                </div>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Apelido p/
                                        Obra</label>
                                    <input name="apelido" class="input" placeholder="Ex: Obra do Centro" />
                                </div>
                                <div>
                                    <label for="obra-cliente"
                                        class="block text-sm font-medium text-gray-700 mb-1">Cliente *</label>
                                    <input id="obra-cliente" name="cliente" class="input" required />
                                </div>
                                <div>
                                    <label for="obra-orcado" class="block text-sm font-medium text-gray-700 mb-1">Valor
                                        Orçado (R$) *</label>
                                    <input id="obra-orcado" name="valor_orcado" data-mask="currency" class="input"
                                        required />
                                </div>
                                <div>
                                    <label for="obra-tolerancia"
                                        class="block text-sm font-medium text-gray-700 mb-1">Tolerância (%)</label>
                                    <input id="obra-tolerancia" name="tolerancia_percentual" type="number" step="0.1"
                                        min="0" class="input" placeholder="Ex: 5" />
                                </div>
                            </div>
                            <div>
                                <label for="obra-descricao"
                                    class="block text-sm font-medium text-gray-700 mb-1">Descrição da Obra</label>
                                <textarea id="obra-descricao" name="descricao_obra" rows="2" class="input"
                                    placeholder="Resumo da obra, escopo, etc."></textarea>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div>
                                    <label for="obra-empresa"
                                        class="block text-sm font-medium text-gray-700 mb-1">Empresa *</label>
                                    <input id="obra-empresa" name="empresa" class="input" required />
                                </div>
                                <div>
                                    <label for="obra-local" class="block text-sm font-medium text-gray-700 mb-1">Local
                                        de Realização</label>
                                    <input id="obra-local" name="local_realizacao" class="input" />
                                </div>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Data Prevista
                                        Início</label>
                                    <input name="data_prevista_inicio" type="date" class="input" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Data Prevista
                                        Fim</label>
                                    <input name="data_prevista_fim" type="date" class="input" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Horas
                                        Previstas</label>
                                    <input name="horas_previstas" type="number" step="0.1" class="input" />
                                </div>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Horas Extras
                                        Previstas</label>
                                    <input name="horas_extras_previstas" type="number" step="0.1" class="input" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Valor Deslocamento
                                        (Km)</label>
                                    <input name="valor_deslocamento_km" data-mask="currency" class="input" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Qtde
                                        Refeições</label>
                                    <input name="qtd_refeicoes" type="number" class="input" />
                                </div>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Qtde
                                        Hospedagens</label>
                                    <input name="qtd_hospedagens" type="number" class="input" />
                                </div>
                                <div class="flex items-center gap-2">
                                    <input id="obra-filha-toggle" type="checkbox" name="is_obra_filha" class="h-4 w-4">
                                    <label for="obra-filha-toggle" class="text-sm text-gray-700">Obra Filha?</label>
                                </div>
                                <div id="obra-filha-wrapper" class="hidden">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Obra Pai
                                        (OS)</label>
                                    <input name="obra_pai_os" class="input" placeholder="Informe a OS da obra pai">
                                </div>
                            </div>
                            <button type="submit" class="btn w-full py-2.5">Salvar Obra</button>
                        </form>
                    </div>

                    <div class="card">
                        <h2 class="text-xl font-bold mb-4">Obras Cadastradas</h2>
                        <div id="obras-table-wrapper" class="overflow-x-auto">
                        </div>
                    </div>
                </section>

                <section id="page-cadastro-compradores" class="page space-y-6">
                    <div class="card">
                        <h2 class="text-xl font-bold mb-4">Gerenciar Compradores</h2>
                        <form id="form-comprador" class="space-y-3 mb-4">
                            <div>
                                <label for="comprador-nome" class="block text-sm font-medium text-gray-700 mb-1">Nome do
                                    Comprador *</label>
                                <input id="comprador-nome" name="nome" class="input" required />
                            </div>
                            <div>
                                <label for="comprador-email" class="block text-sm font-medium text-gray-700 mb-1">Email
                                    (Opcional)</label>
                                <input id="comprador-email" name="email" type="email" class="input" />
                            </div>
                            <button type="submit" class="btn w-full">Salvar Novo Comprador</button>
                        </form>
                        <hr class="my-4">
                        <h3 class="font-medium mb-2">Compradores Cadastrados:</h3>
                        <ul id="lista-compradores" class="text-sm overflow-y-auto" style="max-height: 40vh;"></ul>
                    </div>
                </section>

                <section id="page-cadastro-fornecedores" class="page space-y-6">
                    <div class="card">
                        <h2 class="text-xl font-bold mb-4">Gerenciar Fornecedores</h2>
                        <form id="form-fornecedor" class="space-y-3 mb-4">
                            <div>
                                <label for="fornecedor-nome" class="block text-sm font-medium text-gray-700 mb-1">Nome
                                    do Fornecedor *</label>
                                <input id="fornecedor-nome" name="nome" class="input" required />
                            </div>
                            <div>
                                <label for="fornecedor-cnpj" class="block text-sm font-medium text-gray-700 mb-1">CNPJ
                                    (Opcional)</label>
                                <input id="fornecedor-cnpj" name="cnpj" data-mask="cnpj" class="input"
                                    placeholder="00.000.000/0000-00" />
                            </div>
                            <button type="submit" class="btn w-full">Salvar Novo Fornecedor</button>
                        </form>
                        <hr class="my-4">
                        <h3 class="font-medium mb-2">Fornecedores Cadastrados:</h3>
                        <ul id="lista-fornecedores" class="text-sm overflow-y-auto" style="max-height: 40vh;"></ul>
                    </div>
                </section>

                <section id="page-cadastro-centros-custo" class="page space-y-6">
                    <div class="card">
                        <h2 class="text-xl font-bold mb-4">Gerenciar Centros de Custo</h2>
                        <form id="form-centro-custo" class="space-y-3 mb-4">
                            <div>
                                <label for="cc-nome" class="block text-sm font-medium text-gray-700 mb-1">Nome (Ex:
                                    Fundação) *</label>
                                <input id="cc-nome" name="nome" class="input" required />
                            </div>
                            <div>
                                <label for="cc-codigo" class="block text-sm font-medium text-gray-700 mb-1">Código
                                    (Ex:
                                    01.01) (Opcional)</label>
                                <input id="cc-codigo" name="codigo" class="input" />
                            </div>
                            <button type="submit" class="btn w-full">Salvar Novo C. de Custo</button>
                        </form>
                        <hr class="my-4">
                        <h3 class="font-medium mb-2">Centros de Custo Cadastrados:</h3>
                        <ul id="lista-centros-custo" class="text-sm overflow-y-auto" style="max-height: 40vh;"></ul>
                    </div>
                </section>

                <section id="page-relatorios-fornecedor" class="page space-y-6">
                    <div class="card">
                        <h2 class="text-xl font-bold mb-4">Relatório por Fornecedor</h2>
                        <div class="max-w-md mb-4">
                            <label class="block text-sm font-medium text-gray-700">Selecione o Fornecedor:</label>
                            <select id="relatorio-fornecedor-select" class="input mt-1"></select>
                        </div>
                    </div>
                    <div id="relatorio-fornecedor-content" class="hidden space-y-6">
                        <div class="card text-center">
                            <div class="text-sm font-medium text-gray-500">Total Gasto com <span id="rel-forn-nome"
                                    class="font-bold"></span></div>
                            <div id="rel-forn-total" class="text-3xl font-bold text-red-600"></div>
                        </div>
                        <div class="card">
                            <h3 class="text-lg font-bold mb-4">Histórico de Compras do Fornecedor</h3>
                            <div class="overflow-x-auto">
                                <table class="min-w-full divide-y divide-gray-200">
                                    <thead class="bg-gray-50">
                                        <tr>
                                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">
                                                Obra (O.S.)</th>
                                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">
                                                Data</th>
                                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">
                                                NF-e</th>
                                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">
                                                Valor</th>
                                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">
                                                PDF</th>
                                        </tr>
                                    </thead>
                                    <tbody id="relatorio-fornecedor-table-body" class="divide-y divide-gray-200">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <section id="page-configuracoes" class="page">
                    <div class="max-w-5xl mx-auto space-y-6">
                        <div class="card text-center">
                            <h2 class="text-2xl font-bold mb-2">Configurações</h2>
                            <p class="text-sm text-gray-500">Preferências de notificações e gestão de usuários.</p>
                        </div>

                        <div class="flex flex-col items-center gap-6">
                            <div class="card w-full max-w-4xl space-y-4">
                                <h3 class="text-lg font-semibold text-gray-800">Notificações</h3>
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                    <label class="flex items-center gap-2 text-sm"><input id="notif-channel-toast"
                                            type="checkbox" class="h-4 w-4">Toast no app</label>
                                    <label class="flex items-center gap-2 text-sm"><input id="notif-channel-email"
                                            type="checkbox" class="h-4 w-4">E-mail</label>
                                    <label class="flex items-center gap-2 text-sm"><input id="notif-channel-push"
                                            type="checkbox" class="h-4 w-4">Push</label>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div class="space-y-2">
                                        <div class="font-medium text-sm text-gray-600">Eventos</div>
                                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm">
                                            <label class="flex items-center gap-2"><input id="notif-event-atraso"
                                                    type="checkbox" class="h-4 w-4">Atraso de entrega</label>
                                            <label class="flex items-center gap-2"><input id="notif-event-sla"
                                                    type="checkbox" class="h-4 w-4">SLA de entrega</label>
                                            <label class="flex items-center gap-2"><input id="notif-event-orcamento"
                                                    type="checkbox" class="h-4 w-4">Estouro de orçamento</label>
                                            <label class="flex items-center gap-2"><input id="notif-event-rdo"
                                                    type="checkbox" class="h-4 w-4">Integração RDO</label>
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
                                        <label class="block">
                                            <span class="font-medium text-gray-600">Dias para sinalizar
                                                atraso</span>
                                            <input id="notif-threshold-atraso" type="number" min="0"
                                                class="input mt-1 w-full" />
                                        </label>
                                        <label class="block">
                                            <span class="font-medium text-gray-600">% gasto para alerta</span>
                                            <input id="notif-threshold-percent" type="number" min="0" max="100"
                                                class="input mt-1 w-full" />
                                        </label>
                                        <label class="block md:col-span-2">
                                            <span class="font-medium text-gray-600">Frequência</span>
                                            <select id="notif-frequency" class="input mt-1 w-full">
                                                <option value="imediato">Imediato</option>
                                                <option value="diario">Diário</option>
                                                <option value="semanal">Semanal</option>
                                            </select>
                                        </label>
                                    </div>
                                </div>
                                <div class="flex flex-wrap gap-3 justify-end pt-2">
                                    <button id="notif-reset-btn" type="button"
                                        class="btn-secondary btn-small">Resetar</button>
                                    <button id="notif-test-btn" type="button"
                                        class="btn-secondary btn-small">Testar</button>
                                    <button id="notif-save-btn" type="button" class="btn">Salvar
                                        Preferências</button>
                                </div>
                            </div>

                            <div class="card w-full max-w-4xl space-y-4">
                                <div class="flex justify-between items-center">
                                    <div>
                                        <h3 class="text-lg font-semibold text-gray-800">Usuários</h3>
                                        <p class="text-sm text-gray-500">Disponível para diretores/administradores.
                                        </p>
                                    </div>
                                    <div class="flex gap-2">
                                        <button id="config-refresh-users" type="button"
                                            class="btn-secondary btn-small">Atualizar</button>
                                        <button id="config-add-user" type="button" class="btn btn-small">Novo
                                            Usuário</button>
                                    </div>
                                </div>
                                <div class="overflow-x-auto">
                                    <table class="min-w-full text-sm">
                                        <thead class="text-xs uppercase text-gray-500">
                                            <tr>
                                                <th class="px-3 py-2 text-left">Nome</th>
                                                <th class="px-3 py-2 text-left">E-mail</th>
                                                <th class="px-3 py-2 text-left">Papel</th>
                                                <th class="px-3 py-2 text-right">Ações</th>
                                            </tr>
                                        </thead>
                                        <tbody id="config-users-body" class="divide-y divide-gray-200">
                                            <tr>
                                                <td colspan="4" class="px-3 py-2 text-center text-gray-400">
                                                    Carregando
                                                    usuários...</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </main>
    </div>

    <dialog id="obraEditModal" class="bg-white rounded-lg shadow-xl p-0 w-full max-w-4xl backdrop:bg-gray-900/50">
        <div class="flex justify-between items-center p-4 border-b">
            <h3 class="text-lg font-bold">Editar Obra</h3>
            <button onclick="document.getElementById('obraEditModal').close()"
                class="text-gray-500 hover:text-gray-700">✕</button>
        </div>
        <div class="p-6 overflow-y-auto max-h-[80vh]">
            <form id="form-edit-obra" class="space-y-4">
                <input type="hidden" name="id">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Nome da Obra</label>
                        <input name="nome_obra" class="input mt-1 w-full" required>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Número O.S.</label>
                        <input name="numero_os" class="input mt-1 w-full" required>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Apelido p/ Obra</label>
                        <input name="apelido" class="input mt-1 w-full">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Cliente</label>
                        <input name="cliente" class="input mt-1 w-full" required>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Valor Orçado (R$)</label>
                        <input name="valor_orcado" data-mask="currency" class="input mt-1 w-full" required>
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Descrição</label>
                    <textarea name="descricao_obra" class="input mt-1 w-full" rows="2"></textarea>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Empresa</label>
                        <input name="empresa" class="input mt-1 w-full" required>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Local Realização</label>
                        <input name="local_realizacao" class="input mt-1 w-full">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Tolerância (%)</label>
                        <input name="tolerancia_percentual" type="number" step="0.1" class="input mt-1 w-full">
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Data Prev. Início</label>
                        <input name="data_prevista_inicio" type="date" class="input mt-1 w-full">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Data Prev. Fim</label>
                        <input name="data_prevista_fim" type="date" class="input mt-1 w-full">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Horas Previstas</label>
                        <input name="horas_previstas" type="number" step="0.1" class="input mt-1 w-full">
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Horas Extras Prev.</label>
                        <input name="horas_extras_previstas" type="number" step="0.1" class="input mt-1 w-full">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Valor Deslocamento (Km)</label>
                        <input name="valor_deslocamento_km" data-mask="currency" class="input mt-1 w-full">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Qtde Refeições</label>
                        <input name="qtd_refeicoes" type="number" class="input mt-1 w-full">
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Qtde Hospedagens</label>
                        <input name="qtd_hospedagens" type="number" class="input mt-1 w-full">
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="checkbox" name="is_obra_filha" id="edit-obra-filha" class="h-4 w-4">
                        <label for="edit-obra-filha" class="text-sm text-gray-700">Obra Filha?</label>
                    </div>
                    <div id="obra-edit-filha-wrapper" class="hidden">
                        <label class="block text-sm font-medium text-gray-700">Obra Pai (OS)</label>
                        <input name="obra_pai_os" class="input mt-1 w-full">
                    </div>
                </div>
                <div class="flex justify-end gap-2 pt-4 border-t">
                    <button type="button" onclick="document.getElementById('obraEditModal').close()"
                        class="btn-secondary">Cancelar</button>
                    <button type="submit" class="btn">Salvar Alterações</button>
                </div>
            </form>
        </div>
    </dialog>

    <dialog id="fornecedorEditModal" class="bg-white rounded-lg shadow-xl p-0 w-full max-w-md backdrop:bg-gray-900/50">
        <div class="p-6">
            <h3 class="text-lg font-bold mb-4">Editar Fornecedor</h3>
            <form id="form-edit-fornecedor" class="space-y-4">
                <input type="hidden" name="id">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Nome</label>
                    <input name="nome" class="input mt-1 w-full" required>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">CNPJ</label>
                    <input name="cnpj" data-mask="cnpj" class="input mt-1 w-full">
                </div>
                <div class="flex justify-end gap-2">
                    <button type="button" onclick="document.getElementById('fornecedorEditModal').close()"
                        class="btn-secondary">Cancelar</button>
                    <button type="submit" class="btn">Salvar</button>
                </div>
            </form>
        </div>
    </dialog>

    <dialog id="compradorEditModal" class="bg-white rounded-lg shadow-xl p-0 w-full max-w-md backdrop:bg-gray-900/50">
        <div class="p-6">
            <h3 class="text-lg font-bold mb-4">Editar Comprador</h3>
            <form id="form-edit-comprador" class="space-y-4">
                <input type="hidden" name="id">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Nome</label>
                    <input name="nome" class="input mt-1 w-full" required>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Email</label>
                    <input name="email" type="email" class="input mt-1 w-full">
                </div>
                <div class="flex justify-end gap-2">
                    <button type="button" onclick="document.getElementById('compradorEditModal').close()"
                        class="btn-secondary">Cancelar</button>
                    <button type="submit" class="btn">Salvar</button>
                </div>
            </form>
        </div>
    </dialog>

    <script src="./env.js"></script>
    <script type="module" src="js/app.js"></script>

</body>

</html>
